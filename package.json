{
  "name": "justinvideo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JustInVideo in the browser: the editing engine and, later, the editor",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "make-fixtures": "node scripts/make-fixtures.mjs",
    "make-audio-fixtures": "node scripts/make-audio-fixtures.mjs",
    "make-icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "1.62.1",
    "mediabunny": "^1.62.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^22.19.19",
    "fake-indexeddb": "^6.2.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
